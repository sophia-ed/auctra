# Auctra environment configuration (copy to .env)
# Never commit real secrets. See docs/security.md (to be written).

DATABASE_URL=

SOLANA_RPC_URL=
SOLANA_WS_URL=

NEXT_PUBLIC_SOLANA_NETWORK=

PRESTOCKS_API_URL=https://prestocks.com/api/prestocks

PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=

METEORA_CLUSTER=

# Mainnet is gated OFF by default. A missing value must never enable it.
ENABLE_MAINNET=false

DEMO_MODE=true

# Base URL of the Auctra API used by the web app (browser).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Internal API URL for server-side rendering when running in compose
# (the web container reaches the api container by service name).
API_INTERNAL_URL=http://api:3001

# Solana cluster for the browser wallet. Defaults to devnet; it is never
# silently mainnet. Use "mainnet" only alongside ENABLE_MAINNET=true.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=
